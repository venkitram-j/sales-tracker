# Copy this file to .env and fill in real values. Never commit .env itself.

# Django
SECRET_KEY=change-me-to-a-long-random-string
APP_NAME=Sales Tracker
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=UTC

# Database
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=sales_tracker
# DB_USER=sales_tracker
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432
# DB_CONN_MAX_AGE=60

# Security (production only)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Email (production only - password resets/notifications sent via admin panel actions)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Excel upload limits
EXCEL_UPLOAD_MAX_SIZE=5242880
